        "format": "handlebars",
        "syntax": "mustache",
        "template": "<!DOCTYPE html>\n<html>\n<head>\n    <title>Datos del Sensor</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            margin: 40px;\n            text-align: center;\n        }\n        .data-box {\n            border: 1px solid #ccc;\n            padding: 20px;\n            margin: 20px auto;\n            width: 300px;\n            border-radius: 8px;\n            background-color: #f9f9f9;\n        }\n        .value {\n            font-size: 2em;\n            color: #0056b3;\n            font-weight: bold;\n        }\n    </style>\n</head>\n<body>\n\n    <h1>Lecturas del Sensor</h1>\n\n    <div class=\"data-box\">\n        <h2>Temperatura</h2>\n        <!-- Usa Mustache para insertar el valor de temp -->\n        <p class=\"value\">{{req.params.temp}} &deg;C</p>\n    </div>\n\n    <div class=\"data-box\">\n        <h2>Humedad</h2>\n        <!-- Usa Mustache para insertar el valor de hum -->\n        <p class=\"value\">{{req.params.hum}} %</p>\n    </div>\n\n</body>\n</html>",
